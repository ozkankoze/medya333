{
  "name": "medya333",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "prisma": {
    "seed": "tsx prisma/seed/cli.ts"
  },
  "scripts": {
    "dev": "next dev",
    "build": "PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING=1 prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING=1 prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed/cli.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "gen:stub": "vite-node scripts/gen-prisma-stub.ts",
    "setup": "npm install && docker compose up -d && sleep 5 && prisma generate && prisma migrate dev --name init && npm run db:seed",
    "verify": "npm run typecheck && npm run test && npm run build",
    "migrate:wasm": "tsx scripts/migrate-wasm.mts",
    "test:e2e": "playwright test",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "db:validate-pricing": "vite-node --config vitest.config.ts scripts/validate-pricing.mts",
    "db:stamp": "tsx scripts/db-stamp.mts",
    "db:stamp:check": "tsx scripts/db-stamp.mts --check",
    "env:check": "tsx scripts/check-env-separation.mts",
    "test:smoke": "playwright test --config=playwright.smoke.config.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@t3-oss/env-nextjs": "^0.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ioredis": "^6.0.0",
    "next": "^15.1.6",
    "next-auth": "^5.0.0-beta.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@mrleebo/prisma-ast": "^0.16.0",
    "@playwright/test": "^1.62.1",
    "@prisma/prisma-schema-wasm": "^7.9.0-1.e922089b7d7502aff4249d5da3420f6fa55fc6ad",
    "@prisma/schema-engine-wasm": "^7.9.0-1.e922089b7d7502aff4249d5da3420f6fa55fc6ad",
    "@tailwindcss/postcss": "^4.0.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "dotenv": "^17.4.2",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
