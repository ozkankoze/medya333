// ============================================================================
//  MEDYA 333 — Prisma Schema
//  Mimari v1.0 + Faz 0 kararları
//
//  PARA BİRİMİ KURALI
//  Tüm parasal alanlar TAM SAYI KURUŞ (Int). Float / Decimal KULLANILMAZ.
//  Alan adları `...Minor` ile biter. 249,00 TL = 24900
//
//  KDV KURALI (Faz 0 kararı #4)
//  Kullanıcıya gösterilen ve PricingRule'a girilen TÜM fiyatlar KDV DAHİL'dir.
//  Checkout'ta üzerine KDV EKLENMEZ. Vergi, brüt tutardan geriye doğru ayrıştırılır:
//      taxAmountMinor = round(totalMinor * taxRateBp / (10000 + taxRateBp))
//      subtotalMinor  = totalMinor - taxAmountMinor        // net matrah
//  Sipariş anındaki taxRateBp SNAPSHOT olarak saklanır; oran sonradan değişse
//  bile geçmiş siparişlerin vergi hesabı değişmez.
// ============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7: bağlantı URL'i BURADA TANIMLANMAZ.
//   • Migration / introspection → prisma.config.ts içindeki `datasource.url`
//   • Uygulama çalışma zamanı    → PrismaClient({ adapter: new PrismaPg(...) })
datasource db {
  provider = "postgresql"
}

// ============================================================================
//  ENUMS
// ============================================================================

enum UserRole {
  CUSTOMER
  SUPPORT
  OPERATOR
  ADMIN
  SUPERADMIN
}

enum TargetType {
  PROFILE
  POST
  VIDEO
  CHANNEL
  GROUP
}

enum TargetStatus {
  PENDING
  VERIFIED /// resmî/izinli API ile doğrulandı, zengin önizleme var
  UNVERIFIED /// format normalize edildi, API yok → kullanıcı onayı gerekir
  INVALID
  PRIVATE
  NOT_FOUND
}

enum PricingMode {
  FLAT_TIER /// tüm miktar, düşülen kademenin birim fiyatıyla
  GRADUATED /// her kademe kendi fiyatıyla (progressive)
  /// ⚠️ SABİT PAKET FİYATI. `quantity × unitPrice` YAPILMAZ.
  /// Gerçek satış fiyatı (örn. 500 takipçi = 324,90 ₺) kuruşu kuruşuna
  /// `packagePriceMinor` alanından okunur. 32490 / 500 = 64,98 kuruş gibi
  /// tam sayı olmayan birim fiyatlar yuvarlama hatası üretmesin diye
  /// birim fiyata HİÇ dönüştürülmez.
  PACKAGE
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

/// Manuel fulfillment ilerlemesi nasıl ölçülüyor?
/// METRIC       → sayılabilir (takipçi/beğeni): operatör mevcut değeri girer, fark hesaplanır
/// MANUAL_COUNT → sayılamaz (yorum/profil tanıtımı): operatör teslim adedini doğrudan girer
enum MeasurementMode {
  METRIC
  MANUAL_COUNT
}

enum OrderStatus {
  DRAFT /// Taslak — sipariş henüz oluşturulmadı (sihirbaz devam ediyor)
  PENDING_PAYMENT /// Ödeme Bekleniyor — sipariş var, ödeme yok, FULFILLMENT YOK
  PAID /// Ödeme Alındı
  PROCESSING /// Hazırlanıyor
  STARTED /// İşlem Başladı
  IN_PROGRESS /// Devam Ediyor
  PARTIAL /// Kısmen Tamamlandı
  COMPLETED /// Tamamlandı
  CANCELLED /// İptal Edildi
  REFUNDED /// İade Edildi
  FAILED /// Başarısız
}

/// Durum ≠ olay. "Not eklendi" bir olaydır ama durumu değiştirmez.
enum OrderEventType {
  ORDER_CREATED
  ORDER_CONFIRMED
  FULFILLMENT_COMPLETED
  PAYMENT_PENDING
  PRICE_CHANGED
  CUSTOMER_INFO_ADDED
  CONSENT_ACCEPTED
  GUEST_CLAIMED
  TRACKING_LINK_SENT
  PAYMENT_INITIATED
  PAYMENT_RECEIVED
  PAYMENT_FAILED
  PROCESSING
  STARTED
  PROGRESS_UPDATED
  PARTIAL
  COMPLETED
  CANCELLED
  REFUND_REQUESTED
  REFUNDED
  FAILED
  NOTE_ADDED
  /// Faz 8 — telafi (garanti) kilometre taşları. Müşteriye görünür ve
  /// bildirim üretir; ayrıntı FulfillmentEvent'te kalır.
  REPLACEMENT_APPROVED
  REPLACEMENT_COMPLETED
  TARGET_CONFIRMED
  ASSIGNED
  STATUS_CHANGED
  INVOICE_ISSUED
  SYSTEM
}

/// Fulfillment'ın KENDİ durum makinesi. Order durumuyla birebir eşitlenmez:
/// sipariş "PAID" iken fulfillment "READY"dir (operasyon henüz başlamadı).
enum FulfillmentStatus {
  READY
  PROCESSING
  STARTED
  PARTIAL
  COMPLETED
  FAILED
  REVIEW_REQUIRED
}

enum FulfillmentEventType {
  CREATED
  ASSIGNED
  REASSIGNED
  STARTED
  PROGRESS_UPDATED
  METRIC_DECREASED
  PARTIAL_DELIVERY
  NOTE_ADDED
  COMPLETED
  FAILED
  REVIEW_REQUIRED
  REPLACEMENT_CREATED
  REPLACEMENT_APPROVED
  REPLACEMENT_STARTED
  REPLACEMENT_COMPLETED
}

enum ReplacementStatus {
  DROP_DETECTED
  REVIEW_REQUIRED
  APPROVED
  REPLACEMENT_PROCESSING
  COMPLETED
  REJECTED
}

enum PaymentStatus {
  INITIATED
  /// Sağlayıcıya yönlendirildi, sonuç bekleniyor (3DS dışı bekleme de dahil)
  PENDING
  PENDING_3DS
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
  CHARGEBACK
}

/// Faz 0 kararı #5 — alanlar hazır, gerçek sağlayıcı entegre EDİLMEDİ.
enum InvoiceStatus {
  NOT_REQUIRED
  PENDING
  ISSUED
  FAILED
  CANCELLED
}

enum RefundStatus {
  PENDING
  APPROVED
  COMPLETED
  REJECTED
  FAILED
}

// ============================================================================
//  KULLANICI & AUTH  (Auth.js v5 uyumlu)
// ============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String? /// argon2id. Google-only kullanıcıda null
  name          String?
  phone         String?
  image         String?
  role          UserRole  @default(CUSTOMER)

  /// Misafir siparişten doğan gölge kayıt. Kişi aynı e-posta ile kayıt olursa
  /// claimedAt dolar, isGuest=false olur ve geçmiş siparişleri panele düşer.
  /// FK'ler değişmediği için veri taşıma gerekmez.
  isGuest   Boolean   @default(false)
  claimedAt DateTime?

  balanceMinor Int     @default(0) /// iade/kredi bakiyesi (kuruş)
  isBlocked    Boolean @default(false)
  blockReason  String?

  twoFactorSecret String? /// admin rolleri için zorunlu (Faz 5)
  lastLoginAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts       Account[]
  sessions       Session[]
  orders         Order[]    @relation("customer")
  assignedOrders Order[]    @relation("assignee")
  payments       Payment[]
  auditLogs      AuditLog[] @relation("actor")
  claimTokens    GuestClaimToken[]

  @@index([role])
  assignedFulfillments  Fulfillment[]      @relation("fulfillmentAssignee")
  assignerFulfillments  Fulfillment[]      @relation("fulfillmentAssigner")
  fulfillmentEvents     FulfillmentEvent[] @relation("fulfillmentEventActor")
  assignedReplacements  ReplacementCase[]  @relation("replacementAssignee")

  @@index([email, isGuest])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// MİSAFİR SİPARİŞİ DEVRALMA
/// Yalnızca e-posta eşleşmesine güvenilmez: kullanıcı e-postasını doğruladıktan
/// sonra üretilen tek kullanımlık token ile devralma yapılır.
model GuestClaimToken {
  id        String   @id @default(cuid())
  /// Token'ın kendisi DEĞİL, HMAC hash'i saklanır
  tokenHash String   @unique
  email     String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================================
//  KATALOG — tamamen DB kaynaklı (yeni platform/hizmet = 0 satır frontend)
// ============================================================================

model Platform {
  id   String @id @default(cuid())
  slug String @unique
  name String

  /// Registry anahtarı — slug'dan BAĞIMSIZ. "Instagram Reels" adında ikinci bir
  /// platform açılıp adapterKey="instagram" seçilebilsin diye ayrı tutuldu.
  adapterKey    String @default("generic")
  adapterConfig Json   @default("{}")

  iconSlug     String? /// yerleşik ikon setinden
  iconUrl      String? /// admin SVG yüklemesi — deploy gerekmez
  brandColor   String?
  gradientFrom String?
  gradientTo   String?

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  seoTitle       String?
  seoDescription String?

  services Service[]
  targets  Target[]
  orders   Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model Service {
  id         String   @id @default(cuid())
  platformId String
  platform   Platform @relation(fields: [platformId], references: [id], onDelete: Restrict)

  slug             String
  name             String
  shortDescription String?
  iconSlug         String?

  targetType      TargetType
  measurementMode MeasurementMode @default(METRIC)

  /// Müşteriye gösterilen birim adı: "adet" | "paket" | "hafta" | "kampanya"
  /// SADECE GÖSTERİM içindir. Pricing engine'in numeric quantity mantığına
  /// hiçbir şekilde girmez — fiyat her zaman tam sayı miktar üzerinden hesaplanır.
  unitLabel       String          @default("adet")

  /// Hedef girdisi tamamen DB'den sürülür → yeni hizmet eklemek frontend
  /// değişikliği gerektirmez. Frontend bu alanları render eder.
  inputLabel       String
  inputPlaceholder String
  inputHelpText    String?
  inputExample     String

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  variants ServiceVariant[]
  orders   Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platformId, slug])
  @@index([platformId, isActive, sortOrder])
}

model ServiceVariant {
  id        String  @id @default(cuid())
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  slug         String
  internalName String /// SADECE admin görür: "Premium TR-Havuz v2"

  // --- Müşteriye gösterilen alanlar ---
  customerLabel String /// "Premium"
  tagline       String? /// "Daha hızlı başlar, telafi garantili"
  /// Müşteriye gösterilen uzun açıklama ("Takipçiler Türk'tür, düşüş oranı …")
  description   String?
  badge         String? /// "EN ÇOK TERCİH EDİLEN"
  isDefault     Boolean @default(false)
  isVisible     Boolean @default(true) /// false = sadece admin/manuel sipariş

  /// Sabit paketin müşteriye gösterilen içerik maddeleri.
  /// ⚠️ Bunlar SATILAN ŞEYİN TARİFİDİR; ayrı ayrı fiyatlandırılmaz.
  packageItems String[] @default([])

  // --- Miktar sınırları (frontend slider'ına dönüşür, ham sayı gösterilmez) ---
  minQuantity      Int
  maxQuantity      Int
  quantityStep     Int   @default(1)
  presetQuantities Int[] @default([])

  /// ⚠️ true ⇒ SADECE `presetQuantities` listesindeki miktarlar seçilebilir.
  /// Slider gösterilmez; 7.342 gibi serbest miktarlar hem istemcide hem
  /// sunucuda reddedilir (QUANTITY_NOT_ALLOWED).
  presetOnly Boolean @default(false)

  // --- SLA / vaat ---
  estimatedStartMinutes    Int?
  estimatedCompleteMinutes Int?
  refillDays               Int?

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  pricingRules PricingRule[]
  orders       Order[]
  orderItems   OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serviceId, slug])
  @@index([serviceId, isActive, isVisible, sortOrder])
}

// ============================================================================
//  FİYATLANDIRMA
//  unitPriceMinor KDV DAHİL brüt birim fiyattır (Faz 0 kararı #4).
// ============================================================================

model PricingRule {
  id               String         @id @default(cuid())
  serviceVariantId String
  serviceVariant   ServiceVariant @relation(fields: [serviceVariantId], references: [id], onDelete: Cascade)

  mode     PricingMode @default(FLAT_TIER)
  currency String      @default("TRY")

  minQuantity Int /// dahil
  maxQuantity Int? /// dahil; null = sınırsız

  /// KDV DAHİL, 1 adet, kuruş. `mode = PACKAGE` ise KULLANILMAZ (0 yazılır).
  unitPriceMinor Int
  /// ⚠️ SADECE `mode = PACKAGE`. KDV DAHİL SABİT TOPLAM, kuruş.
  /// Gerçek satış fiyatının tek kaynağı; birim fiyata bölünüp yuvarlanmaz.
  packagePriceMinor Int?
  setupFeeMinor  Int @default(0) /// KDV DAHİL sabit ek ücret

  validFrom  DateTime  @default(now())
  validUntil DateTime?
  priority   Int       @default(0) /// çakışmada büyük olan kazanır
  isActive   Boolean   @default(true)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([serviceVariantId, isActive, minQuantity])
}

/// Vergi oranı tek yerden yönetilir; sipariş anında Order'a snapshot'lanır.
model TaxRate {
  id        String   @id @default(cuid())
  code      String   @unique /// "KDV20"
  name      String /// "KDV %20"
  rateBp    Int /// basis point: %20 → 2000
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  validFrom DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([isActive, isDefault])
}

// ============================================================================
//  HEDEF
// ============================================================================

model Target {
  id         String     @id @default(cuid())
  platformId String
  platform   Platform   @relation(fields: [platformId], references: [id], onDelete: Restrict)
  targetType TargetType

  rawInput     String /// kullanıcının yazdığı ham metin
  normalized   String /// "medya333" — kanonik tanımlayıcı
  canonicalUrl String? /// "https://instagram.com/medya333"
  externalId   String?

  status       TargetStatus @default(PENDING)
  verifiedAt   DateTime?
  verifyMethod String? /// "youtube_data_api" | "oembed" | "format_only"

  /// UNVERIFIED fallback akışında kullanıcı "Bu hedef doğru" onayı verdi mi?
  userConfirmed   Boolean   @default(false)
  userConfirmedAt DateTime?

  // --- Sipariş anında dondurulan önizleme (teslim ölçümünün kanıtı) ---
  displayName   String?
  handle        String?
  avatarUrl     String? /// kendi media-proxy'mize indirilmiş hali
  thumbnailUrl  String?
  followerCount Int?
  isPrivate     Boolean?
  metaSnapshot  Json?
  snapshotAt    DateTime?

  orders     Order[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([platformId, normalized])
  @@index([status])
  @@index([createdAt])
}

// ============================================================================
//  SİPARİŞ
// ============================================================================

model Order {
  id      String @id @default(cuid())
  orderNo String @unique /// "M333-8F2K-4Q1B" — yüksek entropili, tahmin edilemez

  // --- Kullanıcı ---
  userId          String
  user            User      @relation("customer", fields: [userId], references: [id], onDelete: Restrict)
  isGuestOrder    Boolean   @default(false)

  /// Müşteri bilgileri — misafir siparişinde tek kaynak, kayıtlıda snapshot.
  /// İleride fatura entegrasyonu için genişletmeye uygun (adres, TCKN, VKN).
  customerFirstName String?
  customerLastName  String?
  /// Normalize edilmiş (trim + lowercase) e-posta
  customerEmail     String?
  customerPhone     String?

  guestEmail      String?
  guestName       String?
  guestPhone      String?
  accessTokenHash String? /// imzalı takip linki — TOKEN'IN HASH'İ saklanır
  accessExpiresAt DateTime?

  /// ÇİFT SİPARİŞ KORUMASI. Aynı Idempotency-Key ile gelen istek aynı siparişi
  /// döndürür; farklı gövdeyle aynı key gelirse reddedilir (requestHash karşılaştırması).
  idempotencyKey  String?   @unique
  requestHash     String?

  /// SÖZLEŞME ONAYLARI — snapshot. Metin sonradan değişse bile kullanıcının
  /// HANGİ sürümü kabul ettiği kanıtlanabilir olmalı (mesafeli satış mevzuatı).
  consentAcceptedAt      DateTime?
  consentTermsVersion    String?
  consentRefundVersion   String?
  consentPrivacyVersion  String?
  consentSnapshot        Json?

  /// ⚠️ ARŞİV — İş Kuyruğu'ndan kaldırma bayrağı, DURUM DEĞİL.
  /// `OrderStatus`a "ARCHIVED" eklenmedi: eklenseydi siparişin gerçek
  /// durumunu (PAID, COMPLETED…) ezer ve arşivden çıkarıldığında hangi
  /// duruma döneceği bilinemezdi. Arşiv durumdan bağımsız bir görünürlük
  /// bayrağıdır; kayıt ve para izi yerinde durur.
  archivedAt   DateTime?
  archivedById String?

  // --- Denormalize katalog referansları (admin filtreleri JOIN'siz çalışsın) ---
  platformId       String
  platform         Platform       @relation(fields: [platformId], references: [id], onDelete: Restrict)
  serviceId        String
  service          Service        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  serviceVariantId String
  serviceVariant   ServiceVariant @relation(fields: [serviceVariantId], references: [id], onDelete: Restrict)
  targetId         String
  target           Target         @relation(fields: [targetId], references: [id], onDelete: Restrict)
  quantity         Int

  // --- PARA (hepsi kuruş; KDV DAHİL mantığı) -------------------------------
  currency String @default("TRY")

  /// Sipariş anındaki fiyat modeli — SNAPSHOT. `PACKAGE` ise `unitPriceMinor`
  /// anlamsızdır (0) ve müşteri arayüzünde birim fiyat satırı gösterilmez.
  pricingMode       PricingMode @default(FLAT_TIER)
  unitPriceMinor    Int /// KDV dahil brüt birim fiyat (snapshot)
  listSubtotalMinor Int /// unitPrice * quantity + setupFee — indirim öncesi, KDV dahil
  discountMinor     Int @default(0) /// KDV dahil indirim
  totalMinor        Int /// ÖDENEN tutar = list - discount, KDV dahil

  taxRateBp      Int /// SNAPSHOT: %20 → 2000. Oran değişse bile geçmiş bozulmaz
  taxAmountMinor Int /// total içinden ayrıştırılan KDV
  subtotalMinor  Int /// net matrah = total - taxAmount

  couponId   String?
  coupon     Coupon?   @relation(fields: [couponId], references: [id])
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id])

  // --- FATURA (Faz 0 kararı #5: alanlar hazır, entegrasyon YOK) -------------
  invoiceStatus   InvoiceStatus @default(NOT_REQUIRED)
  invoiceProvider String? /// "parasut" | "nilvera" | "logo" ...
  invoiceId       String? /// sağlayıcıdaki kayıt kimliği
  invoiceNumber   String?
  invoiceUrl      String?
  invoicedAt      DateTime?
  invoiceError    String?

  // --- Durum ---
  status       OrderStatus @default(DRAFT)
  assignedToId String?
  assignedTo   User?       @relation("assignee", fields: [assignedToId], references: [id])

  customerNote String?
  adminNote    String?

  ipHash    String? /// ham IP saklanmaz — tuzlu hash
  userAgent String?
  riskScore Int?

  // --- Zaman damgaları ---
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  paidAt       DateTime?
  processingAt DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  refundedAt   DateTime?
  dueAt        DateTime? /// SLA son teslim — geciken sipariş uyarısı

  items       OrderItem[]
  payments      Payment[]
  events        OrderEvent[]
  refunds       Refund[]
  fulfillment   Fulfillment?
  notifications Notification[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([platformId, status])
  @@index([serviceId, status])
  @@index([assignedToId, status])
  @@index([guestEmail])
  @@index([customerEmail])
  /// ⚠️ `idempotencyKey` üzerinde AYRI bir index YOKTUR — alan zaten `@unique`
  /// olduğu için PostgreSQL bir UNIQUE index oluşturur ve o index tüm
  /// aramaları karşılar. İkinci bir btree index yalnızca YAZMA maliyeti ve
  /// disk tüketirdi (Faz 10 ölçümü: iki index'ten yalnızca biri kullanılıyordu).
  /// Migration: 20260819140000_drop_redundant_index
  @@index([dueAt])
  @@index([invoiceStatus])
}

// ============================================================================
//  FULFILLMENT — MANUEL OPERASYON
//
//  ⚠️ Bu tablolar bot/scraping/otomasyon İÇİN DEĞİLDİR. Gerçek kişilerin
//  yaptığı işin kaydını tutar: kim, ne zaman, ne kadar teslim etti.
//  Sistem hiçbir koşulda kendi kendine fulfillment başlatmaz/tamamlamaz.
// ============================================================================

model Fulfillment {
  id      String @id @default(cuid())
  /// ⚠️ 1 Order → 1 Fulfillment. Duplicate webhook ikinci kayıt AÇAMAZ.
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status FulfillmentStatus @default(READY)

  /// Katalog sonradan değişse bile bu fulfillment'ın NE İÇİN açıldığı sabit kalır.
  targetSnapshot Json

  requestedQuantity Int
  deliveredQuantity Int @default(0)

  /// METRIC modunda hedefin ölçülen değerleri. STARTED anında dondurulur —
  /// sipariş ile başlangıç arasındaki organik değişim bize yazılmaz.
  initialMetric Int?
  currentMetric Int?

  assignedToUserId String?
  assignedTo       User?     @relation("fulfillmentAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  assignedById     String?
  assignedBy       User?     @relation("fulfillmentAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedAt       DateTime?

  startedAt   DateTime?
  completedAt DateTime?
  failedAt    DateTime?

  /// ServiceVariant.refillDays snapshot'ından hesaplanır. Garanti bitince
  /// OTOMATİK hiçbir işlem yapılmaz; yalnızca telafi hakkını sınırlar.
  guaranteeDays   Int?
  guaranteeEndsAt DateTime?

  /// Operasyon içi not — müşteriye GÖSTERİLMEZ.
  internalNote String?
  /// Müşteriye gösterilen kontrollü mesaj (SUPPORT+ yazabilir).
  customerNote String?

  /// FAILED sebebi — teknik detay, müşteriye gösterilmez.
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events       FulfillmentEvent[]
  replacements ReplacementCase[]

  @@index([status, createdAt])
  @@index([assignedToUserId, status])
  @@index([createdAt])
}

model FulfillmentEvent {
  id            String      @id @default(cuid())
  fulfillmentId String
  fulfillment   Fulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)

  type FulfillmentEventType

  /// İşlemi yapan operatör/admin. Sistem olaylarında null.
  actorUserId String?
  actor       User?   @relation("fulfillmentEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  /// Bu olayda teslim edilen adet (progress olaylarında)
  quantity       Int?
  previousMetric Int?
  currentMetric  Int?

  fromStatus FulfillmentStatus?
  toStatus   FulfillmentStatus?

  /// ⚠️ PII YAZILMAZ. Operasyon notu; müşteri adı/e-postası buraya girmez.
  note String?

  /// Müşteri zaman çizelgesinde görünür mü?
  isCustomerVisible Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([fulfillmentId, createdAt])
  @@index([type, createdAt])
}

/// Garanti kapsamındaki düşüş telafisi. TAMAMEN MANUEL — otomatik telafi YOK.
model ReplacementCase {
  id            String      @id @default(cuid())
  fulfillmentId String
  fulfillment   Fulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)

  reason String

  /// Telafi açıldığı andaki durum — sonradan değişse bile kanıt kalır
  initialDelivered Int
  currentMetric    Int?
  droppedQuantity  Int?

  replacementQuantity Int

  status ReplacementStatus @default(DROP_DETECTED)

  assignedToUserId String?
  assignedTo       User?   @relation("replacementAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  createdById String?
  approvedById String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([fulfillmentId])
  @@index([status, createdAt])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  serviceVariantId String
  serviceVariant   ServiceVariant @relation(fields: [serviceVariantId], references: [id], onDelete: Restrict)
  targetId         String
  target           Target         @relation(fields: [targetId], references: [id], onDelete: Restrict)

  quantity Int

  // --- Manuel fulfillment ilerlemesi ---
  /// startCount ve goalCount, sipariş anında değil STARTED geçişinde dondurulur:
  /// sipariş ile başlangıç arasındaki organik değişim bize yazılmamalı.
  startCount        Int?
  goalCount         Int? /// startCount + quantity
  currentCount      Int?
  deliveredQuantity Int       @default(0)
  lastProgressAt    DateTime?

  // --- Fiyat anlık görüntüsü (KDV dahil) ---
  unitPriceMinor       Int
  lineSubtotalMinor    Int
  lineTotalMinor       Int
  appliedPricingRuleId String?
  pricingSnapshot      Json /// tam kırılım — denetlenebilirlik

  // --- Katalog anlık görüntüsü (isimler değişse bile geçmiş doğru kalır) ---
  platformNameSnapshot String
  serviceNameSnapshot  String
  variantLabelSnapshot String

  status OrderStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
}

/// Bildirim kanalı. ⚠️ Faz 8'de YALNIZCA EMAIL uygulanmıştır.
/// SMS/WhatsApp bilinçli olarak EKLENMEDİ; enum genişletilebilir bırakıldı.
enum NotificationChannel {
  EMAIL
}

enum NotificationStatus {
  /// Kayıt açıldı, gönderim denenmedi
  PENDING
  SENT
  /// ⚠️ Sağlayıcı yok veya gönderim reddedildi — "gönderildi" SAYILMAZ
  FAILED
  /// Bilinçli atlandı (alıcı adresi yok, şablon eşleşmedi)
  SKIPPED
}

/// ⭐ BİLDİRİM KAYDI (Faz 8)
///
/// Her bildirim BİR OrderEvent'ten doğar — paralel bir event sistemi yoktur.
/// `@@unique([orderEventId, channel])` sayesinde aynı olay için aynı kanaldan
/// ikinci bir gönderim veritabanı seviyesinde imkânsızdır (idempotency).
///
/// ⚠️ Ham e-posta adresi, takip token'ı veya sağlayıcı sırrı BURAYA YAZILMAZ.
model Notification {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  orderEventId String
  orderEvent   OrderEvent @relation(fields: [orderEventId], references: [id], onDelete: Cascade)

  channel  NotificationChannel @default(EMAIL)
  /// Şablon anahtarı — ORDER_CREATED, PAYMENT_RECEIVED, …
  template String
  status   NotificationStatus  @default(PENDING)

  /// ⚠️ PII minimizasyonu: yalnızca MASKELİ adres (ab***@site.com)
  recipientMasked String
  /// Sağlayıcının döndürdüğü kısa hata — sır içermez, 300 karakterle sınırlı
  failureReason String?
  /// Sağlayıcı mesaj kimliği (varsa) — destek taleplerinde iz sürmek için
  providerMessageId String?
  /// Hangi sağlayıcı denedi: console | resend | none
  provider String @default("none")

  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  sentAt    DateTime?

  @@unique([orderEventId, channel])
  @@index([orderId, createdAt])
  @@index([status, createdAt])
  @@index([template, createdAt])
}

model OrderEvent {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  notifications Notification[]

  type       OrderEventType
  fromStatus OrderStatus?
  toStatus   OrderStatus?

  message String?
  payload Json?

  /// Operatörün iç notu müşteri zaman çizelgesinde görünmemeli.
  isCustomerVisible Boolean @default(false)

  actorType String  @default("SYSTEM") /// SYSTEM | CUSTOMER | ADMIN | WEBHOOK
  actorId   String?

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([type, createdAt])
}

// ============================================================================
//  ÖDEME  (Faz 4 — burada sadece şema hazır, entegrasyon yok)
// ============================================================================

model Payment {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  provider      String /// "iyzico" | "paytr" | "mock"
  /// Bizim ürettiğimiz benzersiz referans. iyzico'da conversationId,
  /// PayTR'de merchant_oid olarak gönderilir. Webhook bu alandan bulunur.
  providerRef   String? @unique
  /// Sağlayıcının kendi işlem kimliği (iyzico paymentId gibi)
  providerTxnId String?

  /// Aynı siparişe birden fazla ödeme denemesi. 1'den başlar.
  attemptNumber Int @default(1)

  /// ⚠️ SNAPSHOT — ödeme başlatıldığı andaki değerler. DEĞİŞTİRİLMEZ.
  /// Webhook doğrulaması bunlarla yapılır; Order sonradan değişse bile
  /// ödenen tutar/sipariş eşleşmesi bozulmaz.
  orderNoSnapshot String?
  /// "sandbox" | "production" — canlı ve test kayıtları karışmasın
  environment     String @default("sandbox")

  /// Sağlayıcı checkout bilgisi (kart verisi DEĞİL)
  checkoutUrl       String?
  checkoutToken     String?
  checkoutExpiresAt DateTime?

  status        PaymentStatus @default(INITIATED)
  amountMinor   Int
  currency      String        @default("TRY")
  refundedMinor Int           @default(0)

  // PCI kapsam dışı — sadece maskeli gösterim bilgisi
  cardBrand    String?
  cardLast4    String?
  cardBankName String?
  installment  Int?    @default(1)

  failureCode    String?
  failureMessage String?

  idempotencyKey   String  @unique
  rawInitPayload   Json?
  rawResultPayload Json?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  capturedAt DateTime?

  events  PaymentEvent[]
  refunds Refund[]

  @@unique([orderId, attemptNumber])
  @@index([orderId])
  @@index([status, createdAt])
  @@index([provider, createdAt])
}

/// Webhook replay koruması burada: @@unique([provider, providerEventId])
model PaymentEvent {
  id        String   @id @default(cuid())
  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  provider        String
  providerEventId String
  eventType       String
  signatureValid  Boolean
  payload         Json
  processedAt     DateTime?
  processingError String?
  receivedAt      DateTime  @default(now())

  @@unique([provider, providerEventId])
  @@index([receivedAt])
}

model Refund {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  amountMinor      Int /// KDV dahil iade tutarı
  reason           String
  providerRefundId String?
  providerStatus   String?
  failureMessage   String?
  status           RefundStatus @default(PENDING)

  /// Aynı iade talebinin iki kez işlenmesini engeller
  idempotencyKey String? @unique

  /// İade çift onaylı: ADMIN talep eder, SUPERADMIN onaylar.
  requestedById String
  approvedById  String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([orderId])
  @@index([status])
}

// ============================================================================
//  KUPON & KAMPANYA
// ============================================================================

model Coupon {
  id          String  @id @default(cuid())
  code        String  @unique /// normalize: trim + UPPERCASE
  description String?

  discountType     DiscountType
  discountValue    Int /// PERCENTAGE → basis point (%10 = 1000) · FIXED → kuruş
  maxDiscountMinor Int?
  minOrderMinor    Int?

  // Kapsam — boş dizi = tümü
  platformIds String[] @default([])
  serviceIds  String[] @default([])
  variantIds  String[] @default([])

  maxRedemptions        Int?
  maxRedemptionsPerUser Int? @default(1)
  redemptionCount       Int  @default(0)

  validFrom  DateTime  @default(now())
  validUntil DateTime?
  isActive   Boolean   @default(true)

  orders      Order[]
  redemptions CouponRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, validUntil])
}

model CouponRedemption {
  id          String   @id @default(cuid())
  couponId    String
  coupon      Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId      String
  orderId     String   @unique
  amountMinor Int
  createdAt   DateTime @default(now())

  @@index([couponId, userId])
}

model Campaign {
  id         String  @id @default(cuid())
  slug       String  @unique
  name       String
  bannerText String?

  discountType  DiscountType
  discountValue Int

  platformIds String[] @default([])
  variantIds  String[] @default([])

  startsAt              DateTime
  endsAt                DateTime
  isActive              Boolean  @default(true)
  isStackableWithCoupon Boolean  @default(false)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, startsAt, endsAt])
}

// ============================================================================
//  DENETİM & İZLEME
// ============================================================================

model AuditLog {
  id          String  @id @default(cuid())
  actorId     String?
  actor       User?   @relation("actor", fields: [actorId], references: [id])
  actorIpHash String?

  action     String /// "pricing_rule.update"
  entityType String
  entityId   String
  before     Json?
  after      Json?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model AdapterCallLog {
  id         String   @id @default(cuid())
  adapterKey String
  operation  String
  success    Boolean
  statusCode Int?
  durationMs Int
  errorCode  String?
  createdAt  DateTime @default(now())

  @@index([adapterKey, createdAt])
  @@index([success, createdAt])
}

// ============================================================================
//  DAĞITIM KİMLİĞİ (Faz 10)
// ============================================================================

/// ⭐ BU VERİTABANI HANGİ ORTAMA AİT?
///
/// Ortam ayrımını yalnızca `.env` dosyalarına bırakmak yeterli değildir:
/// staging sunucusuna yanlışlıkla üretim `DATABASE_URL`i yazıldığında hiçbir
/// hata alınmaz — staging sessizce CANLI veriyi yazmaya başlar.
///
/// Bu tablo, veritabanının kendisine ait tek satırlık bir "damga"dır.
/// Uygulama açılışta damgayı okur ve kendi aşamasıyla karşılaştırır;
/// uyuşmazlık BLOCKER'dır (bkz. `src/server/deployment-stamp.ts`).
///
/// Tek satır garantisi: `id` yalnızca "singleton" olabilir (CHECK kısıtı).
model DeploymentStamp {
  id    String @id @default("singleton")
  /// "production" | "staging" | "e2e" | "development"
  stage String

  /// Operatörün bıraktığı serbest not (ör. "hetzner-db-01"). SIR İÇERMEZ.
  label     String?
  stampedAt DateTime @default(now())
  stampedBy String?
}

// ═══════════════════════════════════════════════════════════════════════════
// KASA — GELİR / GİDER DEFTERİ
//
// ⚠️ SİPARİŞ SİSTEMİNDEN TAMAMEN BAĞIMSIZDIR. Buradaki kayıtlar `Order` ile
// ilişkilendirilmez ve site siparişleri buraya otomatik düşmez; her satır
// elle girilir. Bu bilinçli bir tercihtir — tahsilatın büyük kısmı WhatsApp
// üzerinden yürüdüğü için defterin tek gerçeği operatörün girdiğidir.
// İleride bağlanmak istenirse `CashEntry`'ye opsiyonel bir `orderId`
// eklemek yeter; şimdi eklenmedi çünkü kullanılmayan ilişki, dolduruluyor
// sanılan boş bir alan bırakırdı.
//
// ⚠️ BAKİYE SÜTUNU YOKTUR ve EKLENMEMELİDİR. Bakiye hareketlerden türetilir
// (bkz. `src/lib/kasa/calc.ts` başlığı). Saklanan bakiye bir kez kayarsa
// hangi rakamın doğru olduğu bir daha bilinemez.
// ═══════════════════════════════════════════════════════════════════════════

enum CashDirection {
  IN
  OUT
}

/// Elle girilen sipariş defterindeki İŞ durumu.
/// ⚠️ Sitedeki `OrderStatus` ile bilinçli olarak AYRI: burada ödeme durumu
/// `paidAt` ile ayrıca tutulduğu için "Ödeme Bekleniyor" gibi karma
/// durumlara gerek yoktur ve olsaydı iki kaynak birbiriyle çelişirdi.
enum ManualOrderStatus {
  BEKLIYOR
  DEVAM_EDIYOR
  TAMAMLANDI
  IPTAL
}

enum CashCategory {
  /// Sipariş geliri — ciroya girer
  SATIS
  /// Alacak tahsili — bakiyeyi artırır, CİROYA GİRMEZ (satış zaten sayıldı)
  TAHSILAT
  /// Günlük harcama
  GIDER
  /// Tedarikçi / panel ödemesi
  MALIYET
  /// Kredi, taksit, kart borcu
  BORC_ODEME
  /// Hesaplar arası taşıma — hiçbir kâr kalemine girmez
  TRANSFER_IN
  TRANSFER_OUT
  DIGER
}

/// Banka hesabı veya kasa. "Vakıfbank", "Shopier", "Yapıkredi"…
model CashAccount {
  id    String @id @default(cuid())
  /// Müşteriye değil, operatöre gösterilir: "Vakıfbank"
  name  String
  /// Hesabın kime ait olduğu: "Özkan Köse" / "Ayhan Köse"
  owner String

  /// ⚠️ SİSTEME GEÇMEDEN ÖNCEKİ PARA. Hareket DEĞİLDİR: sahte bir "giriş"
  /// satırı olarak yazılsaydı ciro raporunu şişirirdi. Yalnızca bakiyeye eklenir.
  openingBalanceMinor Int @default(0)

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries CashEntry[]

  @@unique([owner, name])
  @@index([isActive, sortOrder])
}

/// Tek bir para hareketi. Defterin atomu.
model CashEntry {
  id        String      @id @default(cuid())
  accountId String
  account   CashAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  /// İşlemin TAKVİM GÜNÜ. Gün başlangıcına sabitlenir; saat tutulmaz —
  /// defter gün bazlıdır ve saat dilimi kayması hafta dağılımını bozardı.
  occurredAt DateTime

  direction CashDirection
  category  CashCategory

  /// ⚠️ HER ZAMAN POZİTİF. Yönü `direction` taşır. Negatif tutara izin
  /// vermek "eksi gider" gibi çift olumsuzlamalara kapı açardı.
  amountMinor Int

  /// Tabloda "İşlem" sütunu
  description String
  /// Tabloda "Kullanıcı Adı" — yalnızca satış satırlarında dolar
  customerHandle String?
  /// Tabloda "Maliyet" — işin bize maliyeti.
  /// ⚠️ BANKA HAREKETİ DEĞİLDİR: bakiyeyi düşürmez, yalnızca kâr hesabına girer.
  /// Tedarikçiye yapılan gerçek ödeme ayrı bir MALIYET satırıdır.
  costMinor Int?

  note String?

  /// Transfer çiftini eşleştirir; iki satır aynı değeri taşır.
  transferGroupId String?

  createdAt   DateTime @default(now())
  createdById String?

  /// Bu hareketi doğuran paket (varsa) — bkz. `ServicePackage`.
  packagePayment ServicePackage? @relation("PackagePayment")
  packageCost    ServicePackage? @relation("PackageCost")

  /// Bu hareketi doğuran elle girilmiş sipariş (varsa) — bkz. `ManualOrder`.
  orderPayment ManualOrder? @relation("ManualOrderPayment")
  orderCost    ManualOrder? @relation("ManualOrderCost")

  /// Bu hareketi doğuran alacak tahsili / borç ödemesi (varsa).
  receivableSettlement Receivable?       @relation("ReceivableSettlement")
  paymentSettlement    ScheduledPayment? @relation("ScheduledPaymentSettlement")

  @@index([accountId, occurredAt])
  @@index([occurredAt])
  @@index([category, occurredAt])
  @@index([transferGroupId])
}

/// ALACAKLAR — bize borçlu olanlar
model Receivable {
  id     String @id @default(cuid())
  person String
  amountMinor Int
  /// Tahmini ödeme tarihi; tabloda "-" yazan satırlar için null
  dueDate DateTime?
  note    String?

  /// Arayüzdeki "İşlem" — ne için alacaklıyız.
  description String?
  /// Satışın bize maliyeti. ⚠️ Bakiyeye girmez; tahsil edildiğinde oluşan
  /// harekete taşınır ve kâr hesabına orada girer.
  costMinor Int?

  /// ⚠️⚠️ TAHSİL EDİLİNCE HANGİ KATEGORİ YAZILACAK?
  ///
  /// İki farklı alacak vardır ve aynı kalıba sokulamazlar:
  ///   TAHSILAT → satış zaten ciroya yazılmıştı, sadece parası gelmemişti.
  ///              SATIS yazılsaydı aynı iş İKİ KEZ ciro sayılırdı.
  ///   SATIS    → hiçbir şey yazılmamıştı, satış yalnızca alacak olarak
  ///              duruyordu. TAHSILAT yazılsaydı o satış ciroda HİÇ
  ///              görünmezdi.
  /// "Hareket ekle" formundan "ödenmedi" ile gelen satırlar ikinci gruptur.
  settleCategory CashCategory @default(TAHSILAT)

  /// Tahsil edildiğinde doldurulur. ⚠️ Satır SİLİNMEZ — geçmiş kaybolmasın.
  settledAt DateTime?
  /// ⚠️ RESTRICT: bağlı hareket silinemez. SetNull olsaydı hareket silinince
  /// bu alan boşalır, `settledAt` dolu kalır ve alacak "tahsil edildi"
  /// görünürken karşılığında hiçbir para olmazdı.
  settledEntryId String?    @unique
  settledEntry   CashEntry? @relation("ReceivableSettlement", fields: [settledEntryId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([settledAt, dueDate])
  @@index([settleCategory])
}

/// AYLIK ÖDEMELER — borç takvimi (kredi, kart, panel…)
model ScheduledPayment {
  id       String @id @default(cuid())
  creditor String

  /// Bu ayki taksit tutarı
  amountMinor Int
  /// Kalan toplam borç — bilgi amaçlı, tabloda "Kalan Total Borç"
  remainingMinor Int?

  dueDate DateTime
  /// Ödendiğinde doldurulur. ⚠️ Satır SİLİNMEZ.
  paidAt  DateTime?
  note    String?

  /// Arayüzdeki "İşlem" — ne için borçluyuz.
  description String?

  /// Ödendiğinde yazılacak kategori. Ödenmemiş bir GİDER ödendiğinde gider
  /// olarak sayılmalıdır; hepsini BORC_ODEME saymak, günlük harcamayı kredi
  /// taksitiyle aynı kaleme yazmak olurdu.
  settleCategory CashCategory @default(BORC_ODEME)

  /// ⚠️ RESTRICT — `Receivable.settledEntry` ile aynı gerekçe.
  paidEntryId String?    @unique
  paidEntry   CashEntry? @relation("ScheduledPaymentSettlement", fields: [paidEntryId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paidAt, dueDate])
}

/// Kasa modülünün tek satırlık ayarı.
model KasaSetting {
  id String @id @default("singleton")

  /// ⚠️ 1 USD KAÇ KURUŞ? (43,50 ₺ → 4350)
  /// Elle girilir; dış servisten çekilmez. Canlı kur, geçmiş kayıtların
  /// gösterdiği doları her sayfa yenilemesinde değiştirirdi.
  usdRateMinor Int @default(0)

  updatedAt DateTime @updatedAt
}

/// AYLIK MÜŞTERİ PAKETİ — elle yönetilen süreli hizmet satışı.
///
/// ⚠️ BU BİR ABONELİK SİSTEMİ DEĞİLDİR.
///   · Otomatik yenileme YOK
///   · Otomatik tahakkuk YOK
///   · Süre bitince yeni kayıt ÜRETİLMEZ
/// Süresi dolan paket yalnızca "süresi doldu" olarak GÖSTERİLİR. Yenileme,
/// operatörün elle açtığı yeni bir kayıttır.
///
/// ⚠️ DURUM ALANI YOKTUR ve eklenmemelidir. "aktif / süresi doldu"
/// tarihlerden TÜRETİLİR (bkz. `lib/kasa/packages.ts`). Saklansaydı
/// bayatlardı: o değeri gece yarısı çevirecek zamanlanmış bir iş yok ve
/// istenmiyor da. Sonuç, süresi geçmiş paketin ekranda "aktif" görünmesi
/// olurdu. Tek istisna `canceledAt` — o bir tarihten çıkmaz, karardır.
///
/// ⚠️ NET KÂR ALANI DA YOKTUR: `salePriceMinor - costMinor` ile hesaplanır.
/// Saklansaydı, satış veya maliyet düzeltildiğinde güncellenmeyi unutabilir
/// ve üç alan birbiriyle çelişirdi.
model ServicePackage {
  id           String @id @default(cuid())
  customerName String
  /// "Sosyal Medya Yönetimi"
  serviceName  String

  startDate DateTime
  endDate   DateTime

  salePriceMinor Int
  costMinor      Int @default(0)

  /// Ödeme ALINDIĞINDA dolar. Ayrı bir `isPaid` bayrağı YOKTUR — bayrak ile
  /// tarih er geç ayrışır ve hangisinin doğru olduğu bilinemez.
  paidAt DateTime?

  /// ⚠️ PAKET AÇILINCA BANKA BAKİYESİ ARTMAZ.
  /// Gelir hareketi YALNIZCA "tahsil edildi" işleminde oluşur ve buraya
  /// bağlanır. Bağ, aynı paketin iki kez tahsil edilmesini engeller.
  paymentEntryId String?    @unique
  /// ⚠️ RESTRICT, SetNull DEĞİL. Şema bir süre `SetNull` diyordu ama
  /// veritabanı `20260825110000_kasa_butunluk` ile RESTRICT'e çevrilmişti.
  /// Bu sapma tehlikeliydi: `prisma migrate dev` çalıştıran biri şemayı
  /// doğru sanıp kuralı sessizce geri alırdı. SetNull ile bağlı hareket
  /// silinince `paymentEntryId` NULL olur, `paidAt` DOLU kalırdı — paket
  /// "tahsil edildi" görünür, karşılığında para olmazdı.
  paymentEntry   CashEntry? @relation("PackagePayment", fields: [paymentEntryId], references: [id], onDelete: Restrict)

  /// Maliyet gerçek bir gider hareketine dönüştürüldüğünde bağlanır.
  /// İsteğe bağlıdır: maliyet girilmiş olsa da kasadan çıkış yapılmamış olabilir.
  costEntryId String?    @unique
  costEntry   CashEntry? @relation("PackageCost", fields: [costEntryId], references: [id], onDelete: Restrict)

  canceledAt DateTime?
  note       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  @@index([customerName])
  @@index([startDate])
  @@index([endDate, canceledAt])
}

/// ⚠️⚠️ ELLE GİRİLEN GÜNLÜK SİPARİŞ DEFTERİ — `Order` İLE KARIŞTIRILMAMALI.
///
/// `Order` gerçek müşteri siparişidir: ödeme akışı üretir, denetim izi
/// taşır, SİLİNEMEZ. Bu tablo işletmenin KENDİ defteridir — elle girilir,
/// elle silinir, yalnızca SUPERADMIN görür ve müşteri tarafıyla hiçbir
/// yabancı anahtar paylaşmaz.
///
/// İkisini tek tabloda birleştirmek cazipti ve yanlış olurdu: gerçek bir
/// siparişte "maliyet" alanı yoktur ve silinebilir bir defteri müşteri
/// kayıtlarıyla aynı tabloya koymak, bir gün yanlış satırın silinmesiyle
/// biterdi.
model ManualOrder {
  id String @id @default(cuid())

  /// Tabloda "Kullanıcı adı"
  customerName String

  /// ⚠️ ARAYÜZDE "Sipariş içeriği" — ZORUNLU.
  /// Siparişin NE olduğu ("Instagram 10K Türk takipçi", "Web site tasarımı").
  /// İsteğe bağlı olsaydı pratikte çoğu satır boş kalır ve defter birkaç hafta
  /// sonra okunamaz hâle gelirdi: aynı müşteriye aynı gün girilen iki satır
  /// birbirinden ayırt edilemezdi.
  /// Boş dize de veritabanında yasaktır (NOT NULL tek başına yetmez).
  description String

  /// İşin TAKVİM GÜNÜ — gün başlangıcına sabitlenir, saat tutulmaz.
  occurredAt DateTime

  salePriceMinor Int
  costMinor      Int @default(0)

  /// ⚠️ NET KÂR ALANI YOKTUR. `salePriceMinor - costMinor` ile hesaplanır.
  /// Saklansaydı satış veya maliyet düzeltildiğinde güncellenmeyi unutabilir
  /// ve üç alan birbiriyle çelişirdi.

  /// ⚠️ İŞ DURUMU — ÖDEME DURUMU DEĞİL. İkisi bağımsızdır: tamamlanmış ama
  /// tahsil edilmemiş bir sipariş olağandır.
  status ManualOrderStatus @default(BEKLIYOR)

  /// Ödeme ALINDIĞINDA dolar. Ayrı bir `isPaid` bayrağı YOKTUR — bayrak ile
  /// tarih er geç ayrışır ve hangisinin doğru olduğu bilinemez.
  paidAt DateTime?

  /// ⚠️ SİPARİŞ GİRMEK BANKA BAKİYESİNİ ARTIRMAZ.
  /// Gelir hareketi YALNIZCA "tahsil edildi" işleminde oluşur ve buraya
  /// bağlanır. Bağ, aynı siparişin iki kez tahsil edilmesini engeller.
  paymentEntryId String?    @unique
  paymentEntry   CashEntry? @relation("ManualOrderPayment", fields: [paymentEntryId], references: [id], onDelete: Restrict)

  /// Maliyet gerçek bir gider hareketine dönüştürüldüğünde bağlanır.
  /// İsteğe bağlıdır: maliyet girilmiş olsa da kasadan çıkış yapılmamış olabilir.
  costEntryId String?    @unique
  costEntry   CashEntry? @relation("ManualOrderCost", fields: [costEntryId], references: [id], onDelete: Restrict)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  @@index([occurredAt])
  @@index([customerName])
}
