###############################################################################
# MEDYA 333 — ENVIRONMENT
#
# Bu dosyayı `.env` olarak kopyalayın ve değerleri doldurun.
# `src/env.ts` boot anında doğrular — eksik ZORUNLU değişkende uygulama AÇILMAZ.
#
# ⚠️ GERÇEK SIRLARI ASLA REPOYA COMMIT ETMEYİN. Bu dosyada yalnızca örnek
#    biçimler ve üretim komutları vardır; hiçbir gerçek anahtar yoktur.
#
# İŞARETLER
#   [ZORUNLU]   → yoksa uygulama açılmaz
#   [CANLI]     → yalnızca canlı ortamda zorunlu (bkz. production-guard.ts)
#   [OPSİYONEL] → yoksa özellik kapalı kalır; sahte davranış üretilmez
#   [SIR]       → gizli değer. Log'a, istemciye ve cevaba asla sızmaz.
#
# CANLI ALAN ADI: https://www.medya333.com
###############################################################################


###############################################################################
# 1) APPLICATION
###############################################################################

# [ZORUNLU] Dağıtım aşaması: "production" | "staging" | "e2e"
#
# ⚠️ `next start` NODE_ENV'i HER ZAMAN "production" yapar; staging ve E2E de
#    üretim derlemesi çalıştırır. "Gerçekten canlıyız" kararı buradan okunur.
# ⚠️ TANIMSIZ = "production" (fail-closed). Canlıda yazmayı unutmak açılış
#    kapısını GEVŞETMEZ.
# ⚠️ Kaçış kapısı değildir: APP_ENV production değilken PAYMENT_ENVIRONMENT
#    production yapılamaz (STAGE_REAL_PAYMENT).
APP_ENV="production"

# [ZORUNLU] Sunucu tarafı taban adres.
#
# ⚠️ Callback, e-posta bağlantısı, sipariş takip linki, canonical ve OG
#    adresleri BUNDAN üretilir. Çalışma zamanında okunur.
# ⚠️ Canlıda HTTPS olmalı ve localhost/example.com içermemelidir; aksi hâlde
#    boot durur (BASE_URL_NOT_HTTPS / BASE_URL_LOCALHOST).
APP_BASE_URL="https://www.medya333.com"

# [ZORUNLU] Derlemeye gömülen genel adres.
#
# ⚠️ APP_BASE_URL İLE AYNI OLMALI. Farklıysa boot uyarı verir
#    (BASE_URL_MISMATCH): sayfa kaynağı bir alan adını, e-postalar başka birini
#    gösterirdi.
NEXT_PUBLIC_SITE_URL="https://www.medya333.com"

# [OPSİYONEL] Görünen site adı
NEXT_PUBLIC_SITE_NAME="Medya 333"
# [OPSİYONEL] Fiyatlar KDV DAHİL gösterilir (Faz 0 kararı #4)
NEXT_PUBLIC_PRICES_TAX_INCLUSIVE="true"

# [OPSİYONEL] Varsayılan KDV oranı, basis point (%20 → 2000).
# ⚠️ Veritabanındaki TaxRate kaydı önceliklidir.
DEFAULT_TAX_RATE_BP="2000"


###############################################################################
# 2) DATABASE
###############################################################################

# [ZORUNLU][SIR] Uygulama bağlantısı (havuzlu olabilir)
DATABASE_URL="postgresql://KULLANICI:PAROLA@HOST:5432/medya333?schema=public"

# [OPSİYONEL][SIR] PgBouncer kullanılıyorsa migration için havuzsuz bağlantı
# DIRECT_DATABASE_URL="postgresql://KULLANICI:PAROLA@HOST:5432/medya333?schema=public"

# [OPSİYONEL][SIR] Yalnızca geliştirme — `prisma migrate dev` shadow DB
SHADOW_DATABASE_URL="postgresql://medya333:medya333@localhost:5432/medya333_shadow?schema=public"

# [OPSİYONEL][SIR] Entegrasyon testleri. Tanımsızsa Testcontainers kullanılır.
TEST_DATABASE_URL="postgresql://medya333:medya333@localhost:5432/medya333_test?schema=public"


###############################################################################
# 3) REDIS
###############################################################################

# [CANLI][SIR] Rate limit + katalog cache.
#
# ⚠️ CANLIDA ZORUNLU — yoksa uygulama BOOT'TA DURUR (REDIS_REQUIRED).
#    Bellek-içi yedek tek süreçliktir; çok örnekli üretimde koruma sağlamaz ve
#    sessizce ona düşmek bir güvenlik açığıdır.
# ⚠️ Redis KAYNAK-OF-TRUTH DEĞİLDİR: sipariş, ödeme ve fiyat yalnızca
#    PostgreSQL'dedir. Redis kaybı veri kaybı DEĞİLDİR (bkz. checklist § 10).
# ⚠️ Sunucuda `maxmemory-policy noeviction` olmalı — sayaçların atılması rate
#    limit'i sessizce devre dışı bırakır.
REDIS_URL="redis://localhost:6379"

# [OPSİYONEL][SIR] Upstash REST kullanılıyorsa
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""


###############################################################################
# 4) AUTH
###############################################################################

# [ZORUNLU][SIR] Oturum imzası. Üretin:  openssl rand -base64 48
AUTH_SECRET=""

# [ZORUNLU][SIR] Misafir sipariş takip linki imzası.
# ⚠️ AUTH_SECRET'tan FARKLI olmalı — aynıysa boot durur (SECRET_REUSE).
# Üretin:  openssl rand -base64 48
ORDER_TOKEN_SECRET=""

# [ZORUNLU][SIR] IP adresleri ham saklanmaz, bu tuzla hash'lenir (KVKK).
# Üretin:  openssl rand -hex 24
IP_HASH_SALT=""

# [OPSİYONEL] Auth.js taban adresi
AUTH_URL="https://www.medya333.com"
AUTH_TRUST_HOST="true"

# [OPSİYONEL][SIR] Google ile giriş — yoksa yalnızca e-posta/şifre çalışır
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# [OPSİYONEL][SIR] İlk SUPERADMIN. Kurulumdan sonra şifreyi değiştirip
# bu iki değişkeni ortamdan KALDIRIN.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""


###############################################################################
# 5) EMAIL
###############################################################################

# [ZORUNLU] Gönderici adresi. Alan adı DNS'te doğrulanmış olmalıdır
# (SPF/DKIM/DMARC — bkz. docs/PRODUCTION_CHECKLIST.md § 9).
MAIL_FROM="siparis@medya333.com"

# [ZORUNLU] Sağlayıcı: "none" | "console" | "resend"
#
# ⚠️ SAĞLAYICI YOKSA SİSTEM "GÖNDERİLDİ" DEMEZ.
#   none    → gönderim yapılmaz, bildirim kaydı FAILED olur. Canlı varsayılanı.
#   console → YALNIZCA GELİŞTİRME. Teslim etmediği hâlde başarı döndürdüğü için
#             CANLIDA BOOT'U DURDURUR (EMAIL_CONSOLE_IN_PRODUCTION).
#   resend  → gerçek gönderim. RESEND_API_KEY olmadan seçilirse boot durur
#             (EMAIL_PROVIDER_KEY_MISSING).
EMAIL_PROVIDER="resend"

# [CANLI][SIR] Resend API anahtarı.
# ⚠️ İstemciye, log'a ve API cevabına asla girmez.
RESEND_API_KEY=""


###############################################################################
# 6) PAYMENT
#
# ⚠️ PayTR BAŞVURUSU ONAYLANMADI. Bu bölüm HAZIRDIR ama doldurulmamıştır.
#    Credential geldiğinde YALNIZCA aşağıdaki değerler girilir; kod değişmez.
###############################################################################

# [ZORUNLU] "iyzico" | "paytr" | "mock"
# ⚠️ "mock" canlıda boot'u durdurur (MOCK_PAYMENT).
PAYMENT_PROVIDER="paytr"

# [ZORUNLU] "sandbox" | "production"
# ⚠️ Canlıda "production" olmalı; APP_ENV production değilken bu değer
#    production yapılamaz (STAGE_REAL_PAYMENT).
PAYMENT_ENVIRONMENT="sandbox"

# [CANLI][SIR] PayTR üye iş yeri bilgileri — sağlayıcı "paytr" ise zorunlu
PAYTR_MERCHANT_ID=""
PAYTR_MERCHANT_KEY=""
PAYTR_MERCHANT_SALT=""

# [CANLI][SIR] iyzico — sağlayıcı "iyzico" ise zorunlu
IYZICO_API_KEY=""
IYZICO_SECRET_KEY=""
# ⚠️ Canlıda sandbox adresi kalırsa boot durur (PROVIDER_SANDBOX_URL)
IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"


###############################################################################
# 7) MONITORING
###############################################################################

# [OPSİYONEL][SIR] Sentry DSN.
#
# ⚠️ SDK PROJEYE KURULU DEĞİL. DSN verilse bile HİÇBİR OLAY GÖNDERİLMEZ;
#    durum "pending_sdk" olur ve hiçbir ekranda "aktif" gösterilmez.
#    Kurulum adımları: docs/PRODUCTION_CHECKLIST.md § 10.
SENTRY_DSN=""
# [OPSİYONEL] Ortam etiketi — verilmezse APP_ENV kullanılır
SENTRY_ENVIRONMENT=""
# [OPSİYONEL] Örnekleme oranı 0–1
SENTRY_TRACES_SAMPLE_RATE="1"


###############################################################################
# 8) ENTEGRASYONU OLMAYAN ALANLAR
#
# ⚠️ Aşağıdakilerin HİÇBİRİ bağlı değildir. Alanlar şemada hazır durur ki
#    entegrasyon geldiğinde kod değil yalnızca ortam değişsin.
###############################################################################

# Platform API'leri — scraping KULLANILMAZ, yalnızca resmî/izinli API'ler
YOUTUBE_API_KEY=""
INSTAGRAM_BUSINESS_DISCOVERY_ENABLED="false"
IG_APP_ID=""
IG_APP_SECRET=""
IG_ACCESS_TOKEN=""
TELEGRAM_BOT_TOKEN=""
X_BEARER_TOKEN=""

# Fatura sağlayıcısı
INVOICE_PROVIDER="none"
INVOICE_API_KEY=""
INVOICE_API_SECRET=""


###############################################################################
# 9) YALNIZCA CI / DERLEME
###############################################################################

# Derleme sırasında env doğrulamasını atlamak için (canlıda ASLA):
# SKIP_ENV_VALIDATION="true"
