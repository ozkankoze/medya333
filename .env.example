###############################################################################
# MEDYA 333 — ENVIRONMENT
#
# Bu dosyayı `.env` olarak kopyalayın ve değerleri doldurun.
# `src/env.ts` boot anında doğrular — eksik ZORUNLU değişkende uygulama AÇILMAZ.
#
# ⚠️ GERÇEK SIRLARI ASLA REPOYA COMMIT ETMEYİN. Bu dosyada yalnızca örnek
#    biçimler ve üretim komutları vardır; hiçbir gerçek anahtar yoktur.
#
# İŞARETLER
#   [ZORUNLU]   → yoksa uygulama açılmaz
#   [CANLI]     → yalnızca canlı ortamda zorunlu (bkz. production-guard.ts)
#   [OPSİYONEL] → yoksa özellik kapalı kalır; sahte davranış üretilmez
#   [SIR]       → gizli değer. Log'a, istemciye ve cevaba asla sızmaz.
#
# CANLI ALAN ADI: https://www.medya333.com
###############################################################################


###############################################################################
# 1) APPLICATION
###############################################################################

# [ZORUNLU] Dağıtım aşaması: "production" | "staging" | "e2e"
#
# ⚠️ `next start` NODE_ENV'i HER ZAMAN "production" yapar; staging ve E2E de
#    üretim derlemesi çalıştırır. "Gerçekten canlıyız" kararı buradan okunur.
# ⚠️ TANIMSIZ = "production" (fail-closed). Canlıda yazmayı unutmak açılış
#    kapısını GEVŞETMEZ.
# ⚠️ Kaçış kapısı değildir: APP_ENV production değilken PAYMENT_ENVIRONMENT
#    production yapılamaz (STAGE_REAL_PAYMENT).
APP_ENV="production"

# [ZORUNLU] Sunucu tarafı taban adres.
#
# ⚠️ Callback, e-posta bağlantısı, sipariş takip linki, canonical ve OG
#    adresleri BUNDAN üretilir. Çalışma zamanında okunur.
# ⚠️ Canlıda HTTPS olmalı ve localhost/example.com içermemelidir; aksi hâlde
#    boot durur (BASE_URL_NOT_HTTPS / BASE_URL_LOCALHOST).
APP_BASE_URL="https://www.medya333.com"

# [ZORUNLU] Derlemeye gömülen genel adres.
#
# ⚠️ APP_BASE_URL İLE AYNI OLMALI. Farklıysa boot uyarı verir
#    (BASE_URL_MISMATCH): sayfa kaynağı bir alan adını, e-postalar başka birini
#    gösterirdi.
NEXT_PUBLIC_SITE_URL="https://www.medya333.com"

# [OPSİYONEL] Görünen site adı
NEXT_PUBLIC_SITE_NAME="Medya 333"
# [OPSİYONEL] Fiyatlar KDV DAHİL gösterilir (Faz 0 kararı #4)
NEXT_PUBLIC_PRICES_TAX_INCLUSIVE="true"

# [OPSİYONEL] Varsayılan KDV oranı, basis point (%20 → 2000).
# ⚠️ Veritabanındaki TaxRate kaydı önceliklidir.
DEFAULT_TAX_RATE_BP="2000"

# [ZORUNLU-GİBİ] İSTEMCİ IP'Sİ HANGİ BAŞLIKTAN OKUNUR? (Faz 11)
#
# ⚠️ BU BİR GÜVENLİK AYARIDIR. Rate limit kimliğini istemci IP'sinden alır;
#    yanlış başlığa güvenmek rate limit'i TAMAMEN atlatılabilir yapar.
#
#   xff-rightmost → `x-forwarded-for` zincirinin EN SAĞDAKİ değeri.
#                   Tek güvenilir hop arkasında (nginx / Caddy / ALB / Vercel)
#                   doğrudur ve sahtelenemez. ⭐ VARSAYILAN.
#   vercel        → Vercel'in yazdığı `x-vercel-forwarded-for` tercih edilir.
#                   Vercel'in ÜSTÜNE bir proxy (ör. Cloudflare) konduğunda bile
#                   Vercel'in yazdığı değeri korur.
#   cloudflare    → `cf-connecting-ip`. YALNIZCA origin'e Cloudflare dışından
#                   erişilemiyorsa güvenlidir; aksi hâlde sahte başlıkla
#                   atlatılır.
#   none          → hiçbir başlığa güvenilmez. Tüm istekler TEK kova paylaşır;
#                   aşırı kısıtlayıcıdır ama sınırsıza DÜŞMEZ.
#
# ⚠️ Ortamdan otomatik tahmin edilmez: güvenlik davranışı dağıtım ortamına göre
#    kendiliğinden değişmemelidir.
TRUSTED_PROXY="xff-rightmost"


###############################################################################
# 2) DATABASE
###############################################################################

# [ZORUNLU][SIR] Uygulama bağlantısı (havuzlu olabilir)
#
# ⚠️ HER ORTAM AYRI VERİTABANI KULLANIR. Staging'in canlı veritabanına
#    erişmesi mümkün OLMAMALIDIR. Bu kural iki mekanizmayla zorlanır:
#      1) `npm run env:check -- .env.staging .env.production`
#         → iki ortamın paylaştığı sırları/adresleri bildirir (değer yazmaz)
#      2) DAĞITIM DAMGASI — veritabanı hangi ortama ait olduğunu KENDİ İÇİNDE
#         saklar. Yanlış ortamdan bağlanan süreç AÇILMAZ.
#         Damgalamak için: npm run db:stamp -- --stage=production
#         Görmek için:     npm run db:stamp:check
#    Matris ve gerekçeler: docs/ENVIRONMENTS.md
DATABASE_URL="postgresql://KULLANICI:PAROLA@HOST:5432/medya333?schema=public"

# [ZORUNLU-GİBİ] SUNUCU BAŞINA BAĞLANTI HAVUZU ÜST SINIRI (Faz 11)
#
# ⚠️ SERVERLESS'TE (Vercel) HAYATİ. Her eşzamanlı fonksiyon örneği KENDİ
#    havuzunu açar ve örnekler arasında paylaşım YOKTUR:
#        50 eşzamanlı örnek × 10 bağlantı = 500 bağlantı
#    Yönetilen PostgreSQL bunu çok önce reddeder ("too many connections") ve
#    sonuç, tam da trafiğin arttığı anda gelen TAM KESİNTİDİR.
#
#    Vercel/Lambda        → 1
#    Docker / VM (tek süreç) → 10 (varsayılan)
#
# ⚠️ Bu ayar HAVUZLU bağlantı adresinin YERİNE GEÇMEZ; onunla BİRLİKTE
#    kullanılır (PgBouncer / Neon pooler / Supabase pooler).
DATABASE_POOL_MAX="10"

# [OPSİYONEL][SIR] Havuzsuz (direct) bağlantı — migration ve şema işlemleri.
# ⚠️ PgBouncer transaction modunda `prisma migrate deploy` ÇALIŞMAZ; migration
#    için havuzsuz adres gerekir. Uygulama bunu KULLANMAZ.
# DIRECT_DATABASE_URL="postgresql://KULLANICI:PAROLA@HOST:5432/medya333?schema=public"

# [OPSİYONEL][SIR] Yalnızca geliştirme — `prisma migrate dev` shadow DB
SHADOW_DATABASE_URL="postgresql://medya333:medya333@localhost:5432/medya333_shadow?schema=public"

# [OPSİYONEL][SIR] Entegrasyon testleri. Tanımsızsa Testcontainers kullanılır.
TEST_DATABASE_URL="postgresql://medya333:medya333@localhost:5432/medya333_test?schema=public"


###############################################################################
# 3) REDIS
###############################################################################

# [CANLI][SIR] Rate limit + katalog cache.
#
# ⚠️ CANLIDA ZORUNLU — yoksa uygulama BOOT'TA DURUR (REDIS_REQUIRED).
#    Bellek-içi yedek tek süreçliktir; çok örnekli üretimde koruma sağlamaz ve
#    sessizce ona düşmek bir güvenlik açığıdır.
# ⚠️ Redis KAYNAK-OF-TRUTH DEĞİLDİR: sipariş, ödeme ve fiyat yalnızca
#    PostgreSQL'dedir. Redis kaybı veri kaybı DEĞİLDİR (bkz. checklist § 10).
# ⚠️ Sunucuda `maxmemory-policy noeviction` olmalı — sayaçların atılması rate
#    limit'i sessizce devre dışı bırakır.
REDIS_URL="redis://localhost:6379"

# [OPSİYONEL][SIR] Upstash REST kullanılıyorsa
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""


###############################################################################
# 4) AUTH
###############################################################################

# [ZORUNLU][SIR] Oturum imzası. Üretin:  openssl rand -base64 48
AUTH_SECRET=""

# [ZORUNLU][SIR] Misafir sipariş takip linki imzası.
# ⚠️ AUTH_SECRET'tan FARKLI olmalı — aynıysa boot durur (SECRET_REUSE).
# Üretin:  openssl rand -base64 48
ORDER_TOKEN_SECRET=""

# [ZORUNLU][SIR] IP adresleri ham saklanmaz, bu tuzla hash'lenir (KVKK).
# Üretin:  openssl rand -hex 24
IP_HASH_SALT=""

# [OPSİYONEL] Auth.js taban adresi
AUTH_URL="https://www.medya333.com"
AUTH_TRUST_HOST="true"

# [OPSİYONEL][SIR] Google ile giriş — yoksa yalnızca e-posta/şifre çalışır
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# [OPSİYONEL][SIR] İlk SUPERADMIN. Kurulumdan sonra şifreyi değiştirip
# bu iki değişkeni ortamdan KALDIRIN.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""


###############################################################################
# 5) EMAIL
###############################################################################

# [ZORUNLU] Gönderici adresi. Alan adı DNS'te doğrulanmış olmalıdır
# (SPF/DKIM/DMARC — bkz. docs/PRODUCTION_CHECKLIST.md § 9).
MAIL_FROM="siparis@medya333.com"

# [ZORUNLU] Sağlayıcı: "none" | "console" | "resend"
#
# ⚠️ SAĞLAYICI YOKSA SİSTEM "GÖNDERİLDİ" DEMEZ.
#   none    → gönderim yapılmaz, bildirim kaydı FAILED olur. Canlı varsayılanı.
#   console → YALNIZCA GELİŞTİRME. Teslim etmediği hâlde başarı döndürdüğü için
#             CANLIDA BOOT'U DURDURUR (EMAIL_CONSOLE_IN_PRODUCTION).
#   resend  → gerçek gönderim. RESEND_API_KEY olmadan seçilirse boot durur
#             (EMAIL_PROVIDER_KEY_MISSING).
EMAIL_PROVIDER="resend"

# [CANLI][SIR] Resend API anahtarı.
# ⚠️ İstemciye, log'a ve API cevabına asla girmez.
RESEND_API_KEY=""


###############################################################################
# 6) PAYMENT
#
# ⚠️ PayTR BAŞVURUSU ONAYLANMADI. Bu bölüm HAZIRDIR ama doldurulmamıştır.
#    Credential geldiğinde YALNIZCA aşağıdaki değerler girilir; kod değişmez.
###############################################################################

# [ZORUNLU] "iyzico" | "paytr" | "mock"
# ⚠️ "mock" canlıda boot'u durdurur (MOCK_PAYMENT).
PAYMENT_PROVIDER="paytr"

# [ZORUNLU] "sandbox" | "production"
# ⚠️ Canlıda "production" olmalı; APP_ENV production değilken bu değer
#    production yapılamaz (STAGE_REAL_PAYMENT).
PAYMENT_ENVIRONMENT="sandbox"

# [CANLI][SIR] PayTR üye iş yeri bilgileri — sağlayıcı "paytr" ise zorunlu
PAYTR_MERCHANT_ID=""
PAYTR_MERCHANT_KEY=""
PAYTR_MERCHANT_SALT=""

# [CANLI][SIR] iyzico — sağlayıcı "iyzico" ise zorunlu
IYZICO_API_KEY=""
IYZICO_SECRET_KEY=""
# ⚠️ Canlıda sandbox adresi kalırsa boot durur (PROVIDER_SANDBOX_URL)
IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"


###############################################################################
# 7) MONITORING
###############################################################################

# [OPSİYONEL][SIR] Sentry DSN.
#
# ⚠️ SDK PROJEYE KURULU DEĞİL. DSN verilse bile HİÇBİR OLAY GÖNDERİLMEZ;
#    durum "pending_sdk" olur ve hiçbir ekranda "aktif" gösterilmez.
#    Kurulum adımları: docs/PRODUCTION_CHECKLIST.md § 10.
SENTRY_DSN=""
# [OPSİYONEL] Ortam etiketi — verilmezse APP_ENV kullanılır
SENTRY_ENVIRONMENT=""
# [OPSİYONEL] Örnekleme oranı 0–1
SENTRY_TRACES_SAMPLE_RATE="1"


###############################################################################
# 8) ENTEGRASYONU OLMAYAN ALANLAR
#
# ⚠️ Aşağıdakilerin HİÇBİRİ bağlı değildir. Alanlar şemada hazır durur ki
#    entegrasyon geldiğinde kod değil yalnızca ortam değişsin.
###############################################################################

# Platform API'leri — scraping KULLANILMAZ, yalnızca resmî/izinli API'ler
YOUTUBE_API_KEY=""

# --- INSTAGRAM BUSINESS DISCOVERY (resmî Meta Graph API) ---------------------
#
# ⚠️ BAYRAK "false" iken HİÇBİR Meta çağrısı yapılmaz ve davranış entegrasyon
#    öncesiyle bit-bit aynıdır. Yalnızca "true" veya "1" açar; başka bir değer
#    (boş, "yes", "TRUE") şema tarafından REDDEDİLİR ve uygulama açılmaz.
#    (Sebep: `Boolean("false") === true` tuzağı — bkz. src/env.ts)
INSTAGRAM_BUSINESS_DISCOVERY_ENABLED="false"
#
# [SIR] Facebook **User** access token — host graph.facebook.com.
#   ⚠️ graph.instagram.com token'ı ÇALIŞMAZ; o API business_discovery'yi
#      desteklemiyor. Gerekli izinler: instagram_basic ·
#      instagram_manage_insights · pages_read_engagement
#   ⚠️ ~60 gün ömürlü. Süresi dolunca sistem sessizce UNVERIFIED'a düşer.
IG_ACCESS_TOKEN=""
# Kendi Instagram professional hesabımızın Business Account ID'si (sadece rakam).
# Bu değer olmadan business_discovery ÇAĞRILAMAZ. Bulmak için: npm run ig:verify
IG_USER_ID=""
# Graph API sürümü. Varsayılan v25.0.
IG_GRAPH_API_VERSION="v25.0"
# [SIR] Yalnızca token yenilemede kullanılır.
IG_APP_ID=""
IG_APP_SECRET=""
#
# ⚠️ HEDEF HESAP PROFESSIONAL OLMALI. Meta kişisel (personal) hesapları hiçbir
#    resmî API'den vermiyor; kişisel hedeflerde akış mevcut onay adımına düşer.
#    Bu bir hata değildir.
# ⚠️ REDIS ŞART. Profil önbelleği ve media-proxy Redis'te tutulur; Redis yoksa
#    profil fotoğrafı servis EDİLMEZ (hotlink'e düşülmez).
TELEGRAM_BOT_TOKEN=""
X_BEARER_TOKEN=""

# Fatura sağlayıcısı
INVOICE_PROVIDER="none"
INVOICE_API_KEY=""
INVOICE_API_SECRET=""


###############################################################################
# 9) YALNIZCA CI / DERLEME
###############################################################################

# Derleme sırasında env doğrulamasını atlamak için (canlıda ASLA):
# SKIP_ENV_VALIDATION="true"


# ---------------------------------------------------------------------------
# MANUEL ÖDEME (GEÇİCİ) — PayTR onayı gelene kadar
# ---------------------------------------------------------------------------
# Açıkken "Ödemeye Geç" düğmesi ödeme sağlayıcısına DEĞİL, sipariş numarası
# hazır yazılmış bir WhatsApp mesajına yönlendirir.
#
# ⚠️ Sipariş PENDING_PAYMENT olarak KALIR. Siparişi "ödendi" yapan tek şey
#    operatörün yönetim panelinden yaptığı ELLE onaydır.
# ⚠️ PayTR bağlandığında tek yapılacak: bunu "false" yapmak. Kod değişmez.
# ⚠️ "false" yazmak KAPATIR (z.coerce.boolean tuzağına düşülmedi).
NEXT_PUBLIC_MANUAL_PAYMENT_ENABLED="false"

# Uluslararası biçim, ülke kodu dahil, sadece rakam: 905xxxxxxxxx
# Boş bırakılırsa WhatsApp düğmesi HİÇ gösterilmez (bozuk bağlantı yerine yok).
NEXT_PUBLIC_WHATSAPP_NUMBER=""


# ---------------------------------------------------------------------------
# GOOGLE ADS — DÖNÜŞÜM TAKİBİ
# ---------------------------------------------------------------------------
# Google tag (gtag.js) dönüşüm kimliği. Boş bırakılırsa etiket HİÇ yüklenmez
# ve Google alan adları CSP'ye de eklenmez.
#
# ⚠️ YALNIZCA PRODUCTION ORTAMINA EKLEYİN. Preview/development dağıtımlarına
#    da eklenirse test tıklamaları gerçek dönüşüm olarak sayılır ve kampanya
#    verisi kirlenir.
# ⚠️ NEXT_PUBLIC_* değişkenleri BUILD SIRASINDA gömülür — ekledikten sonra
#    redeploy şarttır, sadece kaydetmek yetmez.
NEXT_PUBLIC_GOOGLE_ADS_ID=""
