###############################################################################
# MEDYA 333 — ENVIRONMENT
#
# Bu dosyayı `.env` olarak kopyalayın ve değerleri doldurun.
# src/env.ts boot anında doğrular — eksik zorunlu değişkende uygulama AÇILMAZ.
#
# ⚠️  GERÇEK SIRLARI ASLA REPOYA COMMIT ETMEYİN.
###############################################################################

# --- DAĞITIM AŞAMASI (Faz 7) -------------------------------------------------
# "production" | "staging" | "e2e"
#
# ⚠️ `next start` NODE_ENV'i HER ZAMAN "production" yapar; staging ve E2E de
# üretim derlemesi çalıştırır. "Gerçekten canlıyız" kararı bu yüzden APP_ENV'den
# okunur (src/server/production-guard.ts).
#
# ⚠️ TANIMSIZ = "production" (fail-closed). Canlıda yazmayı unutmak açılış
# kapısını GEVŞETMEZ. Ayrıca APP_ENV production değilken PAYMENT_ENVIRONMENT
# production yapılamaz — bu bir kaçış kapısı değildir.
APP_ENV="production"

# --- ZORUNLU: Veritabanı -----------------------------------------------------
DATABASE_URL="postgresql://medya333:medya333@localhost:5432/medya333?schema=public"
# Migration'lar için shadow DB (prisma migrate dev kullanır)
SHADOW_DATABASE_URL="postgresql://medya333:medya333@localhost:5432/medya333_shadow?schema=public"
# Entegrasyon testleri: tanımlıysa bu DB kullanılır, tanımsızsa Testcontainers
TEST_DATABASE_URL="postgresql://medya333:medya333@localhost:5432/medya333_test?schema=public"
# Bağlantı havuzu (PgBouncer) kullanılıyorsa migration'lar için doğrudan bağlantı:
# DIRECT_DATABASE_URL="postgresql://medya333:medya333@localhost:5432/medya333?schema=public"

# --- ZORUNLU: Auth.js --------------------------------------------------------
# Üretin: openssl rand -base64 48
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# --- ZORUNLU: Kriptografik tuzlar --------------------------------------------
# IP adresleri ham saklanmaz, bu tuzla hash'lenir (KVKK)
# Üretin: openssl rand -hex 24
IP_HASH_SALT=""
# Misafir sipariş takip linki imzası
# Üretin: openssl rand -base64 48
ORDER_TOKEN_SECRET=""

# --- Genel -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Medya 333"
# Tüm gösterilen fiyatlar KDV DAHİL (Faz 0 kararı #4)
NEXT_PUBLIC_PRICES_TAX_INCLUSIVE="true"

# --- Vergi -------------------------------------------------------------------
# Basis point: %20 → 2000. DB'deki varsayılan TaxRate kaydı önceliklidir.
DEFAULT_TAX_RATE_BP="2000"

# --- Seed --------------------------------------------------------------------
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

###############################################################################
# FAZ 4 — ÖDEME (Faz 0'da ENTEGRASYON YOK, boş bırakılabilir)
# Sağlayıcı mimarisi bağımsızdır: iyzico ve PayTR birbirinden etkilenmez.
###############################################################################
# Sunucu tarafı taban adres (callback/success URL'leri buradan üretilir).
# NEXT_PUBLIC_SITE_URL derlemeye gömülür; bu değişken çalışma zamanında okunur.
APP_BASE_URL="http://localhost:3000"
PAYMENT_ENVIRONMENT="sandbox"
PAYMENT_PROVIDER="iyzico"
IYZICO_API_KEY=""
IYZICO_SECRET_KEY=""
IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"
PAYTR_MERCHANT_ID=""
PAYTR_MERCHANT_KEY=""
PAYTR_MERCHANT_SALT=""

###############################################################################
# FAZ 6 — PLATFORM API'LERİ (Faz 0'da ENTEGRASYON YOK)
# Bu anahtarlar YALNIZCA sunucuda kullanılır, istemciye asla gönderilmez.
# Scraping kullanılmaz — yalnızca resmî / izin verilen public API'ler.
###############################################################################
YOUTUBE_API_KEY=""
# Meta App Review onayı alınırsa true yapılır; UI otomatik uyum sağlar.
INSTAGRAM_BUSINESS_DISCOVERY_ENABLED="false"
IG_APP_ID=""
IG_APP_SECRET=""
IG_ACCESS_TOKEN=""
TELEGRAM_BOT_TOKEN=""
X_BEARER_TOKEN=""

###############################################################################
# FAZ 8 — FATURA (Faz 0'da SAĞLAYICI YOK, sadece Order alanları hazır)
###############################################################################
INVOICE_PROVIDER="none"
INVOICE_API_KEY=""
INVOICE_API_SECRET=""

###############################################################################
# Opsiyonel altyapı
###############################################################################
# --- REDIS: ÜRETİMDE ZORUNLU -------------------------------------------------
# Rate limit ve katalog cache Redis üzerinden çalışır.
# NODE_ENV=production iken REDIS_URL yoksa uygulama BOOT'TA HATA VERİR:
# bellek-içi rate limit tek süreçlik olduğu için çok örnekli üretimde
# koruma sağlamaz ve sessizce ona düşmek güvenlik açığıdır.
REDIS_URL="redis://localhost:6379"
# --- E-POSTA (Faz 8) ---------------------------------------------------------
MAIL_FROM="siparis@medya333.com"

# "none" | "console" | "resend"
#
# ⚠️ SAĞLAYICI YOKSA SİSTEM "GÖNDERİLDİ" DEMEZ.
#   none    → gönderim yapılmaz, bildirim kaydı FAILED olur. Canlı varsayılanı.
#   console → YALNIZCA GELİŞTİRME. Teslim etmediği hâlde başarı döndürdüğü ve
#             e-posta konularını log'a yazdığı için CANLIDA BOOT'U DURDURUR.
#   resend  → gerçek gönderim; RESEND_API_KEY olmadan seçilemez.
#
# Tanımsızsa: anahtar varsa resend, test'te bellek, canlıda none,
# geliştirmede console (bkz. src/server/mail/provider.ts).
EMAIL_PROVIDER="console"
RESEND_API_KEY=""

SENTRY_DSN=""

# CI/derleme sırasında env doğrulamasını atlamak için:
# SKIP_ENV_VALIDATION="true"
